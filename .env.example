# --- Backend environment variables ---
# Copy this file to .env and fill in the values. The .env file is not committed to git.

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_NAME=microservice_panel
DB_PORT=5432

# RabbitMQ (in Docker: amqp://rabbitmq)
RABBITMQ_URL=amqp://localhost

# --- Redis (optional) ---
# Caches the per-request permission lookup. Leave blank and every lookup goes
# to PostgreSQL instead — the app behaves identically, just with more queries.
# In Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379
# How long a cached permission set may live untouched. Writes invalidate
# explicitly; this only bounds the damage if a delete fails while Redis is down.
PERMISSION_CACHE_TTL_SECONDS=60

# --- Authentication ---
# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=2h

# First Supervisor account, created by `npm run setup-db`.
# Without it nobody can manage permissions. Leave blank to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# Used for document summaries, RAG answers, and real embeddings. Without it the
# app still runs: the two generation routes answer 503, and embeddings fall back
# to an offline provider that matches shared words rather than meaning.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Retrieval-augmented generation ---
# Embedding model. Asked for 768 dimensions to match the vector(768) column.
EMBEDDING_MODEL=gemini-embedding-001
# Force the offline embedder even when a key is present. Anything other than
# "local" is ignored; useful for reproducing what a keyless clone sees.
EMBEDDING_PROVIDER=
# Chunking. Overlap must stay below size, or ingestion refuses to run.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Backend port (optional)
PORT=3006
