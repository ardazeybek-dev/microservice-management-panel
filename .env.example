# --- Backend ortam değişkenleri ---
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e gönderilmez.

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_NAME=odev_veritabani
DB_PORT=5432

# RabbitMQ (Docker'da: amqp://rabbitmq)
RABBITMQ_URL=amqp://localhost

# Google Gemini API anahtarı (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend portu (opsiyonel)
PORT=3006
