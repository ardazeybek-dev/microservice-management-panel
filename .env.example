# --- Backend environment variables ---
# Copy this file to .env and fill in the values. The .env file is not committed to git.

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_NAME=microservice_panel
DB_PORT=5432

# RabbitMQ (in Docker: amqp://rabbitmq)
RABBITMQ_URL=amqp://localhost

# --- Redis (optional) ---
# Caches the per-request permission lookup. Leave blank and every lookup goes
# to PostgreSQL instead — the app behaves identically, just with more queries.
# In Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379
# How long a cached permission set may live untouched. Writes invalidate
# explicitly; this only bounds the damage if a delete fails while Redis is down.
PERMISSION_CACHE_TTL_SECONDS=60

# --- Authentication ---
# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=2h

# First Supervisor account, created by `npm run setup-db`.
# Without it nobody can manage permissions. Leave blank to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend port (optional)
PORT=3006
