# --- Frontend environment variables ---
# Copy this file to .env.local and adjust if needed. .env.local is not committed to git.

# Backend API address. Must match the backend's PORT (set in the root .env).
# Local development: http://localhost:3006
# Docker Compose:    http://backend:3006
#
# If 3006 is already taken on your machine, change PORT in the root .env and
# point this at the same port — the two values are read independently and will
# not agree on their own.
NEXT_PUBLIC_API_URL=http://localhost:3006
